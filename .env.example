# ---- LLM ----
GROQ_API_KEY=gsk_your_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ---- GitHub App (webhook server / AWS Lambda) ----
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./pr-sentinel.private-key.pem
GITHUB_WEBHOOK_SECRET=change-me

# ---- OR a plain token (local CLI runs) ----
# GITHUB_TOKEN=ghp_xxx

# ---- Review tuning ----
MIN_SEVERITY=low          # low | medium | high | critical
MAX_FILES=25
ENABLE_RAG=true
IGNORE_PATTERNS=docs/*,*.generated.ts
